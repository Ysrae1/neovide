+#!/bin/sh
+set -eu
+cd "$(dirname "$0")"
+if [ "$(uname -s)" = Darwin ] && command -v brew >/dev/null 2>&1; then
+    NCURSES_PREFIX=$(brew --prefix ncurses)
+    export PKG_CONFIG_PATH="$NCURSES_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
+fi
+NCURSES_FLAGS=$(pkg-config --cflags --libs ncursesw)
+# pkg-config returns compiler arguments, not user-provided text.
+${CC:-cc} -O2 -D_XOPEN_SOURCE_EXTENDED=1 -o cmatrix cmatrix.c unimatrix.c $NCURSES_FLAGS
+
+# Keep the dedicated entry alongside the normal CMatrix executable.
+cp cmatrix cmatrix-uni-native
