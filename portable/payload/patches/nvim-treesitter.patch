+-- Neovim 0.12 always passes capture lists; older releases honored all=false.
+-- Preserve this plugin's legacy single-node handler behavior.
+local function capture_node(match, id)
+  local capture = match[id]
+  if type(capture) == "table" then
+    return capture[#capture]
+  end
+  return capture
+end
